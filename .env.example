# Optional MACHINE configuration. Copy to .env, or outside repositories on a VM.
# AIH reads this ONLY with: aih --env-file /absolute/path/to/aih.env ...
# Process environment wins; --home overrides AIH_HOME. No expansion of ~, $HOME,
# ${VAR}, shell commands, multiline values, or inline comments. Quotes are optional.
# Never source an untrusted .env as a shell script. Never commit real credentials.

# Default: the current OS user's home directory followed by /.aih.
# Use a local, persistent disk OUTSIDE every application/source checkout.
# AIH_HOME=/absolute/path/to/persistent/aih-state

# Executable names on PATH or full paths, never commands with flags.
CODEX_BINARY=codex
CLAUDE_BINARY=claude

# Optional fork/upstream override for release checks and staged updates.
# AIH_RELEASE_REPO=owner/ai-agentic-harness

# Prefer each tool's normal login store; no API key is mandatory for AIH itself.
# Only set credentials needed by your selected provider; see docs/AGENTS_SETUP.md.
# OPENAI_API_KEY=replace-locally-if-using-api-billing
# ANTHROPIC_API_KEY=replace-locally-if-using-api-billing
# CLAUDE_CODE_OAUTH_TOKEN=replace-locally-if-using-setup-token
# GH_TOKEN=replace-locally-only-if-not-using-gh-login

# On Unix: chmod 600 the copied file. Do not put secrets in command arguments,
# objectives, issue bodies, AGENTS.md, or .aih/project.yaml.
